# Copy this file to .env and fill it in. Never commit .env. Blank = use the default. See README.md for where each value comes from.

# --- Required ---------------------------------------------------------------

# [required] Anthropic API key from console.anthropic.com -> API Keys (pay-per-use, separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=
# [required] Long random password the Pebble app sends as "Authorization: Bearer <value>"; generate one, see README step 4.
WEBHOOK_SECRET=
# [required] Secret ntfy topic name for push notifications; anyone who knows it can read them, so make it long and random.
NTFY_TOPIC=
# [required] https:// plus your server's hostname, e.g. https://my-ring.duckdns.org (used for notification buttons and Notion login).
PUBLIC_BASE_URL=
# [required] Your timezone in IANA format, e.g. America/New_York or Europe/London (default: UTC).
RING_TZ=

# --- Integrations (leave blank to switch one off) ---------------------------

# [optional] TickTick API token from ticktick.com -> Settings -> Account -> API Token.
TICKTICK_API_TOKEN=
# [optional] Notion internal integration secret from notion.so/profile/integrations (fallback Notion path).
NOTION_TOKEN=
# [optional] ID of a Notion page shared with your integration where Undo writes a log (32 characters from the page URL).
NOTION_UNDO_PAGE_ID=
# [optional] true/false: use Notion's hosted MCP server after `scripts/notion_oauth.py begin` (default: true).
NOTION_MCP_ENABLED=
# [optional] Notion MCP server address (default: https://mcp.notion.com/mcp).
NOTION_MCP_URL=
# [optional] Google Calendar to add events to; "primary" is your main calendar (default: primary).
GOOGLE_CALENDAR_ID=
# [optional] Path to the Google OAuth client file you download from Google Cloud (default: google_client_secret.json).
GOOGLE_CLIENT_SECRET_FILE=
# [optional] Path to the Google login token made by scripts/setup_google.py (default: google_token.json).
GOOGLE_TOKEN_FILE=

# --- Behaviour (defaults are fine) ------------------------------------------

# [optional] Comma-separated tools that never run without an Approve tap (default: ticktick_delete_task,calendar_delete_event,notion_trash_page).
APPROVAL_REQUIRED_TOOLS=
# [optional] Claude model for everyday captures (default: claude-sonnet-4-6).
MODEL=
# [optional] Bigger Claude model used when you say "think hard" (default: claude-fable-5).
ESCALATION_MODEL=
# [optional] Maximum tool calls per capture before the agent stops (default: 8).
MAX_AGENT_TURNS=
# [optional] ntfy server address if you self-host ntfy (default: https://ntfy.sh).
NTFY_SERVER=
# [optional] Folder for captures.db, audio and context; the server units set this to /opt/ring-agent (default: the app folder).
DATA_DIR=

# --- Used only by scripts/deploy.sh and scripts/captures.sh on your computer ---

# [deploy] SSH login for your server, e.g. ubuntu@my-ring.duckdns.org.
RING_HOST=
# [deploy] Path to the SSH private key for your server, e.g. ~/.ssh/ring_server.
RING_SSH_KEY=
# [deploy] Your server's hostname without https://, e.g. my-ring.duckdns.org (sets up HTTPS on deploy).
RING_DOMAIN=
